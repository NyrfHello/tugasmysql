CREATE DATABASE db_penjualan;
USE db_penjualan;

CREATE TABLE Perusahaan (
    id_perusahaan INT AUTO_INCREMENT PRIMARY KEY,
    nama_perusahaan VARCHAR(100) NOT NULL,
    alamat TEXT,
    no_telepon VARCHAR(20),
    email VARCHAR(50),
    website VARCHAR(50)
);

CREATE TABLE Produk (
    kode_produk VARCHAR(20) PRIMARY KEY,
    nama_produk VARCHAR(100) NOT NULL,
    harga_satuan DECIMAL(15, 2) NOT NULL
);

CREATE TABLE Stok_Bulanan (
    id_stok INT AUTO_INCREMENT PRIMARY KEY,
    id_perusahaan INT,
    kode_produk VARCHAR(20),
    periode_bulan VARCHAR(20),
    tahun YEAR,
    jumlah_awal INT DEFAULT 0,
    pemasukan INT DEFAULT 0,
    pengeluaran INT DEFAULT 0,
    jumlah_akhir INT DEFAULT 0,
    nilai_stok_akhir DECIMAL(15, 2) DEFAULT 0.00,
    FOREIGN KEY (id_perusahaan) REFERENCES Perusahaan(id_perusahaan),
    FOREIGN KEY (kode_produk) REFERENCES Produk(kode_produk)
);

CREATE TABLE Toko (
    id_toko INT AUTO_INCREMENT PRIMARY KEY,
    nama_toko VARCHAR(100) NOT NULL,
    alamat TEXT,
    no_telepon VARCHAR(50)
);

CREATE TABLE Detail_Penjualan (
    id_detail INT AUTO_INCREMENT PRIMARY KEY,
    nama_barang VARCHAR(100) NOT NULL,
    kuantitas DECIMAL(10, 2) NOT NULL,
    harga_satuan DECIMAL(15, 2) NOT NULL,
    subtotal DECIMAL(15, 2) NOT NULL
);

CREATE TABLE Transaksi (
    no_transaksi VARCHAR(50),
    id_detail INT,
    id_toko INT,
    tanggal_waktu DATETIME NOT NULL,
    nama_kasir VARCHAR(50) NOT NULL,
    pelanggan VARCHAR(50) DEFAULT 'UMUM/CASH',
    total_bayar DECIMAL(15, 2) NOT NULL,
    tunai DECIMAL(15, 2) NOT NULL,
    kembalian DECIMAL(15, 2) NOT NULL,
    PRIMARY KEY (no_transaksi, id_detail),
    FOREIGN KEY (id_toko) REFERENCES Toko(id_toko),
    FOREIGN KEY (id_detail) REFERENCES Detail_Penjualan(id_detail)
);
